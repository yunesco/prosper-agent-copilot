{
  "name": "prosper-agent-builder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,voice --prefix-colors blue,magenta \"npm:dev:web\" \"npm:dev:voice\"",
    "dev:web": "npm --prefix frontend run dev",
    "dev:voice": "uv run --locked --directory backend python bot.py"
  },
  "devDependencies": {
    "concurrently": "9.2.4"
  }
}
