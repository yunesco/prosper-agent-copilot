# Shared server-side configuration for Python voice and Next.js Copilot.
# Copy to .env and fill in. Provided by the challenge.
# (Voice and model live in the agent JSON, e.g. example_flow.json, not here.)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional Copilot model override; does not change the voice model.
COPILOT_MODEL=gpt-5.5
